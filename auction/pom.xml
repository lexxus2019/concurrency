<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>auction-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>auction</artifactId>
    <name>auction</name>
    <description>Сервис аукциона: хранит товары и ставки в памяти</description>

    <properties>
        <!-- Boot 3.5 по умолчанию тащит Artemis 2.40, который не запускается на JDK 23+
             (UnsupportedOperationException: getSubject is not supported; проверено — 2.41
             тоже ещё сломан). Просим свежую версию: свойство переопределяет import
             artemis-bom в родительском BOM. Предупреждение "relocated to
             org.apache.artemis" — это миграция Artemis на новый groupId (2.50+), Maven
             подхватывает сам, оно безвредное. -->
        <artemis.version>2.57.0</artemis.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Ветка fix/10: очередь сообщений вместо блокировок.
             artemis-jakarta-server = ядро брокера + JMS-часть в jakarta-неймспейсе,
             нужен для spring.artemis.mode=embedded (класс JMSConfiguration). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-artemis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.activemq</groupId>
            <artifactId>artemis-jakarta-server</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
